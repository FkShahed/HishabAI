# HisabAI Backend — Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Google Gemini AI ────────────────────────────────────────────────────────────
# Gemini API key — NEVER expose this in the mobile app
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model — change here to swap model without code changes
# Current default: gemini-2.5-flash (replaces deprecated gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# ─── Google Cloud Vision OCR ─────────────────────────────────────────────────────
# OCR provider — change here to swap provider without code changes
# Options: google_vision | mock
OCR_PROVIDER=google_vision

# Application Default Credentials for Google Cloud Vision
# Point to your service-account JSON file (do NOT use GOOGLE_CLOUD_VISION_API_KEY)
# Obtain from: Google Cloud Console → IAM → Service Accounts → Keys → JSON
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# ─── Firebase Admin SDK ──────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# ─── CORS ────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081
